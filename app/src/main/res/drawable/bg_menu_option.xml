<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_fill_strong" />
            <stroke android:width="1.2dp" android:color="@color/glass_stroke_bright" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/glass_fill" />
                    <stroke android:width="1.2dp" android:color="@color/glass_stroke" />
                    <corners android:radius="22dp" />
                </shape>
            </item>
            <item android:top="1dp" android:left="1dp" android:right="1dp" android:bottom="34dp">
                <shape android:shape="rectangle">
                    <gradient android:type="linear" android:angle="90" android:startColor="@color/glass_highlight" android:endColor="@android:color/transparent" />
                    <corners android:radius="21dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
