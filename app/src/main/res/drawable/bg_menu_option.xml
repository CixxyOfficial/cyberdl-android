<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/cyber_panel_soft" />
            <stroke android:width="1.5dp" android:color="@color/cyber_cyan" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/cyber_panel" />
            <stroke android:width="1dp" android:color="@color/cyber_border" />
            <corners android:radius="22dp" />
        </shape>
    </item>
</selector>
